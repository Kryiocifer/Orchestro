{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orchestro",
  "version": "2.3.0",
  "identifier": "com.orchestro.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Orchestro",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$AUDIO/**",
          "$DOCUMENT/**",
          "$DOWNLOAD/**",
          "$HOME/**",
          "$APPDATA/**",
          "$DATA/**",
          "**/*.mp3",
          "**/*.flac",
          "**/*.m4a",
          "**/*.aac",
          "**/*.ogg",
          "**/*.wav"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE1ODk3NDk4OTdFRUMwMzQKUldRMHdPNlhtSFNKRlJLS1ZGaVpqVmZYVjVQaEk1N2MxWVVQS3VJVWFBcmx3OC9Kek0yNVk5WkUK",
      "endpoints": [
        "https://github.com/Kryiocifer/Orchestro/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}